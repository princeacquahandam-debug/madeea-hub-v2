# Production build config for the public DEMO deployment (Vercel).
#
# This makes `vite build` boot the app in demo mode: seed/sample data, no
# Supabase backend, auto-signed-in as the FJ Caballes persona. It exists so the
# deployed site loads without any Vercel dashboard env vars.
#
# ⚠️ Demo mode is PUBLIC and auto-logs-in as an admin over seed data only — there
# is no real backend or private data behind it. When you wire the real Supabase
# backend, DELETE this file (or set the two VITE_SUPABASE_* vars in Vercel) so the
# app serves live, authenticated data instead of the demo dataset.
VITE_ALLOW_DEMO=true
